# Runtime settings for local development.
# Copy to .env and adjust as needed. Relative paths resolve against the
# project root (kfc-rag-chatbot-code), independent of the working directory.
DATA_ROOT=./data_split
CHROMA_PATH=./chroma_db
SQLITE_PATH=./sqlite_db/kfc_chatbot.db
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=gemma3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
API_HOST=127.0.0.1
API_PORT=8000
# JSON list; restrict to your own origins outside a local demo.
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]